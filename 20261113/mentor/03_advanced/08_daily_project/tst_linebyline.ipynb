    "import torch\n",
    "import math\n",
    "\n",
    "q=torch.tensor([[1.,0.],[0.,1.],[1.,1.]])   # shape=(3,2)\n",
    "k=torch.tensor([[1.,0.],[0.,1.],[1.,1.]])   # shape=(3,2)\n",
    "\n",
    "\n",
    "scores=q@k.T/math.sqrt(q.shape[-1])     # shape=(3,3)\n",
    "scores.shape\n"
   ]
